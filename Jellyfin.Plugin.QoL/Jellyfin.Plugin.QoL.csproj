<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.QoL</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.QoL</AssemblyName>
    <Version>1.0.1.0</Version>
    <FileVersion>1.0.1.0</FileVersion>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.8">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.8">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <None Remove="Web\userSettingsPage.html" />
    <None Remove="Web\userSettingsPage.js" />
    <None Remove="Web\userSettingsBridge.js" />
    <None Remove="Web\userSettingsKeybindIntegration.js" />
    <None Remove="Web\runtimeSettings.js" />
    <None Remove="Web\clientBootstrap.js" />
    <None Remove="Web\recordInput.js" />
    <None Remove="Web\inputRegistry.js" />
    <None Remove="Web\gestureResolver.js" />
    <None Remove="Web\gestureResolverDirectionalPolicy.js" />
    <None Remove="Web\universalInput.js" />
    <None Remove="Web\controlBridge.js" />
    <None Remove="Web\guardManager.js" />
    <None Remove="Web\launcherRuntime.js" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Web\userSettingsPage.html" />
    <EmbeddedResource Include="Web\userSettingsPage.js" />
    <EmbeddedResource Include="Web\userSettingsBridge.js" />
    <EmbeddedResource Include="Web\userSettingsKeybindIntegration.js" />
    <EmbeddedResource Include="Web\runtimeSettings.js" />
    <EmbeddedResource Include="Web\clientBootstrap.js" />
    <EmbeddedResource Include="Web\recordInput.js" />
    <EmbeddedResource Include="Web\inputRegistry.js" />
    <EmbeddedResource Include="Web\gestureResolver.js" />
    <EmbeddedResource Include="Web\gestureResolverDirectionalPolicy.js" />
    <EmbeddedResource Include="Web\universalInput.js" />
    <EmbeddedResource Include="Web\controlBridge.js" />
    <EmbeddedResource Include="Web\guardManager.js" />
    <EmbeddedResource Include="Web\launcherRuntime.js" />
  </ItemGroup>
</Project>